# Copy to services/agent/.env (ignored by git). Use the password from infra/.env.
# Read only by the Python agent runtime, never by Electron's renderer.
DATABASE_URL=postgresql+asyncpg://lumi:choose_a_local_development_password@127.0.0.1:5432/lumi_agent

# How long a granted approval may be claimed for execution. Checked when the
# approval is claimed, so an expired one is unusable even with no cleanup job.
APPROVAL_TTL_SECONDS=300

# LUMI_RUNTIME_TOKEN is intentionally absent. Electron main mints it for each
# process generation and passes it only in that child's controlled environment.
# A manual app.server run must set a fresh value of at least 32 characters.

# Used only by the test suite, which truncates this database. Must end in _test.
TEST_DATABASE_URL=postgresql+asyncpg://lumi:choose_a_local_development_password@127.0.0.1:5432/lumi_agent_test

# --- Browser worker (optional) -----------------------------------------------
# Leave both unset and the runtime has no browser capability at all; the browser
# routes answer 503. A URL without a token is refused rather than treated as an
# unauthenticated channel to something that performs real side effects.
#
# Mint the token with trusted code, never by hand:
#   python -c "from app.browser.session import generate_worker_token as g; print(g().get_secret_value())"
# Give the SAME value to the worker process as LUMI_BROWSER_TOKEN. It travels in
# a header, never in a URL, and must never reach the Electron renderer.
# BROWSER_WORKER_URL=http://127.0.0.1:8802
# BROWSER_WORKER_TOKEN=
# How long the runtime waits for one dispatch. Generous on purpose: cutting a
# consequential operation short does not undo it, it only turns a knowable
# outcome into an unknown one.
# BROWSER_WORKER_TIMEOUT_SECONDS=120
