            "CREATED",
            "PLANNING",
            "READY",
            "WAITING_APPROVAL",
            "EXECUTING",
            "VERIFYING",
            "OUTCOME_UNKNOWN",
            "RECONCILING",
            "SUCCEEDED",
            "FAILED",
            "CANCELLED",
            "PAUSED"
