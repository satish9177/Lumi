# Development only: Lumi loads ignored .env and .env.local files from the
# repository root. Inherited shell variables win; .env.local overrides .env.
# Keep this key only in your local process environment or an ignored local file.
# Lumi's Electron main process uses it to mint Realtime credentials and make
# explicitly confirmed GPT-5.6 screen-review requests. Never expose it to renderer code.
OPENAI_API_KEY=your_openai_api_key

# Realtime voice and image-context model. The mini model is Lumi's safe default;
# set gpt-realtime-2.1 for the higher-quality Realtime model when needed.
LIFELENS_REALTIME_MODEL=gpt-realtime-2.1-mini
# Valid values for supported Realtime models: low, medium, high.
LIFELENS_REALTIME_REASONING=low

# Read-only structured reasoning over one explicitly confirmed screen capture.
# Verified during Build Week against the Responses API on 2026-07-20.
LUMI_REASONING_MODEL=gpt-5.6-terra
# Valid values: low, medium, high. Low keeps the review responsive.
LUMI_REASONING_EFFORT=low

# ---- Milestone 6: providers and routing (all optional) ----------------------
# Voice provider: openai (default) or gemini (Gemini Live on Vertex AI, relayed by main).
# LUMI_VOICE_PROVIDER=gemini
# Vertex AI (Gemini Live + Gemini text) uses Google Application Default Credentials:
#   gcloud auth application-default login   (or GOOGLE_APPLICATION_CREDENTIALS=<service-account.json>)
# LUMI_VERTEX_ENABLED=1
# LUMI_VERTEX_PROJECT=your-gcp-project
# LUMI_VERTEX_LOCATION=us-central1
# LUMI_GEMINI_LIVE_MODEL=gemini-live-2.5-flash-native-audio
# LUMI_GEMINI_TEXT_MODEL=gemini-2.5-flash
# DeepSeek text (cheap structured extraction):
# DEEPSEEK_API_KEY=your_deepseek_api_key
# LUMI_OPENAI_TEXT_MODEL=gpt-5.6-terra
# Routing override (JSON), see docs/PROVIDERS.md:
# LUMI_MODEL_ROUTES={"intent_extraction":{"providers":["gemini:gemini-2.5-flash-lite","openai"]}}
# Time zone used to resolve "tomorrow" / "Saturday" (defaults to the system zone):
# LUMI_TIMEZONE=Asia/Kolkata
# Show redacted model/controller diagnostics:
# LUMI_DIAGNOSTICS=1

# Optional Telegram integration. Leave blank unless you configure it locally.
TELEGRAM_API_ID=your_telegram_api_id
TELEGRAM_API_HASH=your_telegram_api_hash
